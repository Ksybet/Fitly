# PostgreSQL settings. URL-encode special characters used in connection URLs.
POSTGRES_USER=fitly
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=fitly
POSTGRES_TEST_DB=fitly_test
DATABASE_URL=postgresql://fitly:replace-with-a-strong-password@postgres:5432/fitly
TEST_DATABASE_URL=postgresql://fitly:replace-with-a-strong-password@postgres:5432/fitly_test

# Application settings
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
HOST=0.0.0.0
PORT=3000
CLIENT_URL=http://localhost:3001

# Optional administrator bootstrap. Remove ADMIN_PASSWORD after first creation.
# Password: 12-128 characters with lowercase, uppercase, digit, and special character.
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRUST_PROXY_HOPS=1

# Optional Expo enhanced push security token.
EXPO_ACCESS_TOKEN=
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_WORKER_LEASE_SECONDS=60

# Development host ports
API_HOST_PORT=3000
POSTGRES_HOST_PORT=55432

# Container timezone
TZ=Europe/Moscow
